# SEOGEO Audit Kit — API settings.
# Copy to .env (git-ignored) for local development. In production, set these as environment
# variables on the server (e.g. Railway → Variables). Never commit real keys, and never put
# them in the web app: the browser must never see them.

# --- Keys (secret) ----------------------------------------------------------------------

# Claude: fact extraction, judging and fixes. Set a monthly spend limit in the Anthropic Console.
ANTHROPIC_API_KEY=

# Free Google key for PageSpeed Insights (Core Web Vitals). Without it Google allows almost
# no requests. Cloud Console → enable "PageSpeed Insights API" → Credentials → API key.
PSI_API_KEY=

# --- Audit limits -----------------------------------------------------------------------

MAX_URLS=5000
USER_AGENT=SEOGEOAuditKitBot/0.1 (+https://github.com/jaylahoti/seogeo-audit-kit)

# Comma-separated origins allowed to call the API (the web app's URL).
CORS_ORIGINS=http://localhost:3001

# --- Coming next (not read yet) ------------------------------------------------------------
