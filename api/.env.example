# SEOGEO Audit Kit — API settings.
# Copy to .env (git-ignored) for local development. In production, set these as environment
# variables on the server (e.g. Railway → Variables). Never commit real keys, and never put
# them in the web app: the browser must never see them.

# --- Keys (secret) ----------------------------------------------------------------------

# Claude: fact extraction, judging and fixes. Set a monthly spend limit in the Anthropic Console.
ANTHROPIC_API_KEY=

# Free Google key for PageSpeed Insights (Core Web Vitals). Without it Google allows almost
# no requests. Cloud Console → enable "PageSpeed Insights API" → Credentials → API key.
PSI_API_KEY=

# Optional, self-hosted: ask the same visibility questions in other AI engines.
# Each engine runs only when its key is set, and is billed to that key. The hosted demo sets none.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# PERPLEXITY_MODEL=sonar
# GEMINI_MODEL=gemini-2.5-flash

# --- Audit limits -----------------------------------------------------------------------

# Smart sampling. The hosted demo keeps these defaults; raise them when self-hosting.
MAX_SITEMAPS=50
MAX_URLS=5000
CRAWL_PER_TEMPLATE=6
SAMPLES_PER_TEMPLATE=5
MAX_COUNT_FILES=2000
USER_AGENT=SEOGEOAuditKitBot/0.1 (+https://github.com/jaylahoti/seogeo-audit-kit)

# Comma-separated origins allowed to call the API (the web app's URL).
CORS_ORIGINS=http://localhost:3001

# Hard cap on Claude spend per audit, in USD.
MAX_AUDIT_COST_USD=0.50

# Public-demo limits (requests from localhost are never limited). Set both to 0 when self-hosting.
FREE_AUDITS_PER_DAY=3
DAILY_BUDGET_USD=5
# Behind a proxy (Railway, Fly, nginx), read the visitor IP from X-Forwarded-For.
TRUST_PROXY=false
# Visitor IPs are stored only as salted hashes. Set a random value in production.
VISITOR_SALT=change-me

# Saved audits. SQLite file by default; Postgres in production.
# DATABASE_URL=postgresql+psycopg://seogeo:seogeo@localhost:5433/seogeo

# --- Coming soon (not read yet) -----------------------------------------------------------
# Account connections for site owners (Search Console, Bing Webmaster, GA4):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BING_WEBMASTER_API_KEY=
