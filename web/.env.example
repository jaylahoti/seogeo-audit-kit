# SEOGEO Audit Kit — web app settings.
# Copy to .env.local (git-ignored). Every NEXT_PUBLIC_ value is sent to visitors' browsers,
# so only public URLs belong here — never API keys. Keys live on the API server.

# Where the site is served (used for share-image and canonical URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Where the API runs (used from Day 2, when the UI loads real audits).
NEXT_PUBLIC_API_URL=http://localhost:8001
